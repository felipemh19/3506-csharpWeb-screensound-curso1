@page "/musicas"
@inject MusicaAPI musicaAPI

<MudStack Class="mt-4 mb-4" Row="true" Justify="Justify.SpaceBetween">
    <MudText Class="mb-4" Typo="Typo.h4">Músicas cadastradas</MudText>
    <MudPagination Count="@totalPages" SelectedChanged="PageChanged"></MudPagination>
</MudStack>

@if (musicasPerPage is not null)
{
    <MudGrid>
        @foreach (var musica in musicasPerPage)
        {
            <MudItem xs="3">
                <CardMusica Musica="musica" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private ICollection<MusicaResponse>? musicas;
    private ICollection<MusicaResponse>? musicasPerPage;
    private int size = 8;
    private int totalItems;
    private int totalPages;

    protected override async Task OnInitializedAsync()
    {
        musicas = await musicaAPI.GetMusicasAsync();

        if (musicas is not null)
        {
            musicas = musicas.OrderByDescending(a => a.Id).ToList();
            totalItems = musicas.Count;
            totalPages = (int)Math.Ceiling((double)totalItems / size);
            this.PageChanged(1);
        }
    }

    private void PageChanged(int page)
    {
        if (musicas is not null)
        {
            var index = page - 1;
            musicasPerPage = musicas.Skip(index * size).Take(size).ToList();
        }
    }
}
