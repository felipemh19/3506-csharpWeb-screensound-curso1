@page "/musicas/editar/{NomeMusica}"
@inject MusicaAPI musicaAPI
@inject ArtistaAPI artistaAPI
@inject GeneroAPI generoAPI
@inject NavigationManager navigationManager

<MudPaper Class="px-8 pt-2 pb-4 mx-12 my-8">

    <MudText Class="mt-8" Typo="Typo.h4">Edição de músicas</MudText>

    <MudForm>
        <MudTextField Class="mt-4" T="string" Label="Nome"
                      @bind-Value="nome"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="Campo obrigatório" />

        <MudNumericField Class="mt-4" T="int" Label="Ano de lançamento"
                      @bind-Value="anoLancamento"
                      Variant="Variant.Outlined"
                      Required="true"
                      RequiredError="Campo obrigatório" />

        <MudSelect Class="mt-4" T="ArtistaResponse" Label="Artista" Variant="Variant.Outlined" Value="ArtistaMusica" ValueChanged="@ArtistaSelected">
            @if (artistas is not null)
            {
                @foreach (var artista in artistas)
                {
                    <MudSelectItem Value="artista">@artista.Nome</MudSelectItem>
                }
            }
        </MudSelect>

        <MudSelect T="GeneroResponse" Label="Gênero" Variant="Variant.Outlined" MultiSelection="true" @bind-SelectedValues="generosSelecionados">
            @if (generos is not null)
            {
                @foreach (var genero in generos)
                {
                    <MudSelectItem T="GeneroResponse" Value="@genero">@genero.Nome</MudSelectItem>
                }
            }
        </MudSelect>

        <MudStack Row Class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="@Cancel">
                Cancelar
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       OnClick="@DeleteMusicaAsync">
                Excluir
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@UpdateMusicaAsync">
                Salvar
            </MudButton>
        </MudStack>
    </MudForm>
</MudPaper>

@code {
    private string? nome;
    private int anoLancamento;
    private int? artistaId;

    [Parameter]
    public string? NomeMusica { get; set; }
    public MusicaResponse? Musica { get; set; }

    private ICollection<ArtistaResponse>? artistas;
    private ICollection<GeneroResponse>? generos;

    private IReadOnlyCollection<GeneroResponse>? generosSelecionados = [];

    private ArtistaResponse? ArtistaMusica { get; set; }

    protected override async Task OnInitializedAsync()
    {
        artistas = await artistaAPI.GetArtistasAsync();
        generos = await generoAPI.GetGenerosAsync();

        Musica = await musicaAPI.GetMusicaPorNomeAsync(NomeMusica!);

        if (Musica is not null)
        {
            nome = Musica.Nome;
            anoLancamento = Musica.AnoLancamento;
            artistaId = Musica.ArtistaId;

            ArtistaMusica = artistas?.FirstOrDefault(x => x.Id == artistaId);

            if (Musica.Generos is not null && generos is not null)
            {
                generosSelecionados = generos
                    .Where(g => Musica.Generos.Contains(g.Id))
                    .ToList();
            }
        }
    }

    private void ArtistaSelected(ArtistaResponse artista)
    {
        ArtistaMusica = artista;
    }

    private async Task UpdateMusicaAsync()
    {
        var musica = new MusicaRequestEdit(Musica!.Id, nome!, anoLancamento, ArtistaMusica!.Id);
        await musicaAPI.UpdateMusicaAsync(musica);
    }

    private async Task DeleteMusicaAsync()
    {
        await musicaAPI.DeleteMusicaAsync(Musica!.Id);
        navigationManager.NavigateTo("/musicas");
    }

    private void Cancel()
    {
        navigationManager.NavigateTo("/musicas");
    }
}
